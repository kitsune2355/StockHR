# ============================================================
#  ไฟล์ที่ห้ามขึ้น repo
# ============================================================

# ---------- ค่าตั้งประจำเครื่อง ----------
# .env มีรหัสผ่านฐานข้อมูล ต่างกันในแต่ละเครื่อง
# คัดลอกจาก .env.example แล้วกรอกค่าเอง
# กันทุกไฟล์ที่ขึ้นต้นด้วย .env แล้วยกเว้น .env.example ตัวเดียว
.env*
!.env.example

# ไฟล์เชื่อมต่อรุ่นเก่าที่เคยฝังรหัสผ่านไว้ในโค้ด
config_ctrl/connect.php
config_ctrl/config.inc.php
config_ctrl/config2.inc.php

# ---------- ไฟล์ที่ผู้ใช้อัปโหลด ----------
# โลโก้บริษัทถูกอัปโหลดผ่านหน้าเว็บ เป็นข้อมูลของแต่ละที่ ไม่ใช่ตัวโปรแกรม
assets/img/company/

# ---------- ของเครื่องมือแก้ไขและระบบปฏิบัติการ ----------
_notes/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ร่องรอย Subversion ที่ติดมากับ PHPMailer ตั้งแต่ตอนดาวน์โหลด ไม่ได้ใช้
.svn/

# ---------- ไฟล์ชั่วคราว / สำรอง ----------
*.log
*.bak
*.tmp
*.orig
*~
