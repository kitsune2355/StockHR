# ============================================================
#  ตัวอย่างค่าตั้งประจำเครื่อง
#
#  คัดลอกเป็น .env แล้วแก้ค่า      copy .env.example .env
#  ไฟล์ .env ตัวจริงอยู่ใน .gitignore เพราะมีรหัสผ่าน ห้ามเอาขึ้น repo
#  และถูกกันไม่ให้เปิดผ่านเว็บด้วย .htaccess ที่รากโปรเจกต์
# ============================================================

# ---------- ฐานข้อมูล ----------
DB_HOST=localhost
DB_USER=ชื่อผู้ใช้ฐานข้อมูล
DB_PASS=รหัสผ่านฐานข้อมูล
DB_NAME=stock_hl


# ---------- การส่งอีเมล ----------
# instant = ส่งทันทีตอนเกิดเหตุการณ์ ผู้ใช้รอเพิ่มราว 1-3 วินาทีต่อฉบับ
# queue   = เข้าคิวอย่างเดียว รอ cron หรือปุ่ม "ส่งคิวเดี๋ยวนี้" มาหยิบไปส่ง
MAIL_SEND_MODE=instant

# ส่งได้สูงสุดกี่ฉบับต่อการกดหนึ่งครั้ง กันกรณีคิวค้างเยอะแล้วหน้าค้างยาว
MAIL_INSTANT_LIMIT=5

# วินาทีที่ยอมรอ SMTP ต่อฉบับ เกินกว่านี้ปล่อยค้างไว้ให้ cron ส่งต่อ
MAIL_TIMEOUT=8
