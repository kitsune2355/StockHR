# ============================================================
#  กันไฟล์ที่ห้ามให้เปิดผ่านเว็บ
#
#  ตอนนี้รหัสผ่านอยู่ใน config_ctrl/connect.php ซึ่งเป็นไฟล์ .php
#  Apache รันมันก่อนส่งออกอยู่แล้ว จึงไม่มีทางอ่านโค้ดข้างในผ่านเว็บได้
#
#  กฎด้านล่างเป็นเกราะสำรอง เผื่อวันหลังมีไฟล์ตั้งค่าที่ไม่ใช่ .php เพิ่มเข้ามา
#  (เคยทดสอบแล้วว่าไฟล์แบบนั้นเปิดผ่านเว็บได้ตรง ๆ ได้ HTTP 200 พร้อมรหัสผ่าน)
#
#  เขียนสองชุดเพราะไวยากรณ์ของ Apache 2.2 กับ 2.4 ไม่เหมือนกัน
#  ถ้าโฮสต์ปิด AllowOverride ไฟล์นี้จะไม่มีผล ต้องกันด้วยวิธีของโฮสต์แทน
# ============================================================

<IfModule mod_authz_core.c>
    # Apache 2.4 ขึ้นไป
    <FilesMatch "^\.(env|git|htpasswd)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    <FilesMatch "^\.(env|git|htpasswd)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ไม่ให้ไล่ดูรายชื่อไฟล์ในโฟลเดอร์ที่ไม่มี index
Options -Indexes
