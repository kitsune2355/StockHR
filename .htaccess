# ============================================================
#  กันไฟล์ที่ห้ามให้เปิดผ่านเว็บ
#
#  .env มีรหัสผ่านฐานข้อมูลอยู่ข้างใน ถ้าไม่กัน ใครก็เปิด
#  https://โดเมน/stock_hl/.env แล้วอ่านได้ตรง ๆ (ทดสอบแล้วได้ HTTP 200 จริง)
#
#  เขียนสองชุดเพราะไวยากรณ์ของ Apache 2.2 กับ 2.4 ไม่เหมือนกัน
#  เครื่องพัฒนาเป็น 2.2 ส่วนโฮสต์ไม่รู้รุ่นแน่ชัด ใส่ทั้งคู่จึงปลอดภัยกว่า
#
#  ถ้าโฮสต์ปิด AllowOverride ไฟล์นี้จะไม่มีผล ต้องไปกันด้วยวิธีของโฮสต์แทน
#  ตรวจได้โดยเปิด URL ข้างบน ถ้าได้ 403 หรือ 404 คือกันอยู่
# ============================================================

<IfModule mod_authz_core.c>
    # Apache 2.4 ขึ้นไป
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2
    <FilesMatch "^\.env">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ไม่ให้ไล่ดูรายชื่อไฟล์ในโฟลเดอร์ที่ไม่มี index
Options -Indexes
